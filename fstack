    "nhere": ("nhere [DIR]",
        "Open DIR (default: the current directory) in Nautilus. Handy for\n"
        "going from the terminal to the file manager. To keep the folder\n"
        "for later, npush it too.",
        "nautilus DIR", "nopen, npush"),
    "nhelp": ("nhelp [CMD]",
        "With no argument, show how the whole set of commands fits together.\n"
