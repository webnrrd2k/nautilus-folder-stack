    "open": ("fstack open [N]",
        "Open entry N (default 0) in Nautilus.",
        None, "nopen"),
    "clear": ("fstack clear",
        "Empty the stack and remove its 📌 sidebar bookmarks.",
        None, "nclear"),
    "help": ("fstack help [CMD]",
        "Show the overview, or help for CMD. CMD can be an fstack subcommand\n"
        "(push, pop, ...) or a shell command (npush, npop, ...).",
        None, "nhelp"),
    "version": ("fstack version",
        "Print the version number.", None, None),
}
ALIASES = {"top": "peek", "ls": "list"}


def help_text(topic=None):
    if not topic:
        return OVERVIEW
    topic = ALIASES.get(topic, topic)
    if topic not in HELP:
        die(f"no help for {topic!r}; commands are: " + ", ".join(HELP), 2)
    usage, desc, same, related = HELP[topic]
    out = [f"Usage: {usage}", "", desc]
    if same or related:
        out.append("")
    if same:
        out.append(f"Same as: {same}")
    if related:
        out += [f"Related: {related}"]
    out += ["", "Run `nhelp` (or `fstack help`) to see how all the commands fit together."]
    return "\n".join(out)


def die(msg, code=1):
    print(f"fstack: {msg}", file=sys.stderr)
    sys.exit(code)


def index_arg(args, store, default=0):
    if not args:
        n = default
    else:
        try:
            n = int(args[0])
        except ValueError:
            die(f"not a stack position: {args[0]!r}")
    if not store.stack:
        die("stack is empty")
    if not 0 <= n < len(store.stack):
        die(f"no entry {n} (stack has {len(store.stack)}: 0..{len(store.stack) - 1})")
    return n


def local_path_or_die(uri):
    p = uri_to_path(uri)
    if p is None:
        die(f"not a local folder: {uri}")
    return p


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("list", [])
    if cmd in ("-h", "--help"):
        print(help_text())
        return
    if cmd == "help":
        print(help_text(args[0] if args else None))
        return
    if cmd in ("-V", "--version", "version"):
        print(f"fstack {VERSION}")
        return
    if "-h" in args or "--help" in args:
        print(help_text(cmd if ALIASES.get(cmd, cmd) in HELP else None))
        return
    store = Store()

    if cmd == "push":
        target = args[0] if args else "."
        if not os.path.isdir(target):
            die(f"not a directory: {target}")
        uri = store.push(target)
        print(f"pushed {display(uri)}  ({len(store.stack)} on stack)", file=sys.stderr)

    elif cmd == "pop":
        if not store.stack:
            die("stack is empty")
        print(local_path_or_die(store.remove(0)))

    elif cmd in ("peek", "top"):
        if not store.stack:
            die("stack is empty")
        print(local_path_or_die(store.stack[0]))

    elif cmd == "get":
        print(local_path_or_die(store.stack[index_arg(args, store)]))

    elif cmd == "drop":
        uri = store.remove(index_arg(args, store))
        print(f"dropped {display(uri)}", file=sys.stderr)

    elif cmd in ("list", "ls"):
        if not store.stack:
            print("(stack is empty)", file=sys.stderr)
        for i, uri in enumerate(store.stack):
            print(f"{i:2}  {display(uri)}")

    elif cmd == "open":
        uri = store.stack[index_arg(args, store)]
        try:
            subprocess.Popen(["nautilus", uri], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            subprocess.Popen(["xdg-open", uri], start_new_session=True)

    elif cmd == "clear":
        store.stack = []
        store.save()
        print("stack cleared", file=sys.stderr)

    else:
        die(f"unknown command {cmd!r} (try: fstack help)", 2)


if __name__ == "__main__":
    main(sys.argv[1:])
